---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const aanbieders = (await getCollection('aanbieders')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Aanbieders — beste reisaanbieders op een rij"
  description="Ontdek zorgvuldig geselecteerde reisaanbieders: van autoverhuur op Curaçao tot cruises, wintersport en reizen op maat."
>
  <section class="section-tight">
    <div class="container">
      <span class="eyebrow">Aanbieders</span>
      <h1>De beste aanbieders op reisgebied</h1>
      <p class="lede">Elke aanbieder op deze pagina is er niet zomaar bij gezet: we kijken naar specialisme, service en betrouwbaarheid voor we een profiel opnemen.</p>
      <div class="disclosure">
        TravelConcurrent kan een commerciële samenwerking hebben met een deel van onderstaande aanbieders.
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {aanbieders.map((entry) => (
          <div class="card">
            <span class="tag">{entry.data.category}</span>
            <h3><a href={`/aanbieders/${entry.id}`}>{entry.data.name}</a></h3>
            <p>{entry.data.summary}</p>
            {entry.id === 'uitmetkorting' && (
              <p><a href="https://www.uitmetkorting.nl/avonturenboerderij-molenwaard/" target="_blank" rel="noopener">Voordelig naar Avonturenboerderij Molenwaard</a></p>
            )}
            <a class="card-link" href={`/aanbieders/${entry.id}`}>Bekijk profiel &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
